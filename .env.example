# ─── Cloudflare Workers AI (required for evaluate/tailor/digest scoring) ───
# Get from: https://dash.cloudflare.com/?to=/:account/workers/ai
CLOUDFLARE_API_KEY=your_api_key_here
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# ─── Resend (optional - for daily digest email) ───
# Get from: https://resend.com/api-keys
# onboarding@resend.dev works out of the box (delivers only to your own
# address); switch to you@your-verified-domain.com once you verify a domain.
RESEND_API_KEY=re_your_api_key_here
MAIL_FROM=onboarding@resend.dev
MAIL_TO=your@email.com

# ─── SMTP / Gmail (alternative email method) ───
# For Gmail: generate an App Password at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your_16_char_app_password
# MAIL_FROM=your-email@gmail.com
# MAIL_TO=your-email@gmail.com