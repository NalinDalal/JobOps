# ─── Cloudflare Workers AI (required for evaluate/tailor/digest scoring) ───
CLOUDFLARE_API_KEY=your_api_key_here
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# ─── Resend (required for daily digest email) ───
# onboarding@resend.dev works out of the box (delivers only to your own
# address); switch to you@your-verified-domain.com once you verify a domain.
RESEND_API_KEY=re_your_api_key_here
MAIL_FROM=onboarding@resend.dev
MAIL_TO=your@email.com